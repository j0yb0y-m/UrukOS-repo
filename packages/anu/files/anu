#!/usr/bin/env python3
"""anu - UrukOS post-install helper.

Commands: setup, install, update, doctor, fw, tpm.
Skeleton for M3; real app registry lands at M5.
"""

import argparse
import logging
import subprocess
import sys

LOG_PATH = "/var/log/anu.log"


def get_logger() -> logging.Logger:
    logger = logging.getLogger("anu")
    logger.setLevel(logging.INFO)
    fmt = logging.Formatter("%(asctime)s %(levelname)s %(message)s")
    try:
        fh = logging.FileHandler(LOG_PATH)
        fh.setFormatter(fmt)
        logger.addHandler(fh)
    except OSError:
        pass  # not writable (non-root); continue without file logging
    sh = logging.StreamHandler()
    sh.setFormatter(fmt)
    logger.addHandler(sh)
    return logger


def run(cmd: list[str], dry_run: bool, logger: logging.Logger) -> int:
    logger.info("+ %s", " ".join(cmd))
    if dry_run:
        return 0
    try:
        return subprocess.run(cmd, check=False).returncode
    except FileNotFoundError:
        logger.error("command not found: %s", cmd[0])
        return 127


def cmd_setup(args, logger) -> int:
    logger.info("anu setup: post-install wizard (M5 will implement codecs, RPM Fusion, Flatpak remotes)")
    return 0


def cmd_install(args, logger) -> int:
    logger.info("anu install %s (dry-run=%s)", args.id, args.dry_run)
    if args.dry_run:
        logger.info("would install app '%s' via its registered method", args.id)
        return 0
    logger.warning("app registry is not implemented yet (M5)")
    return 1


def cmd_update(args, logger) -> int:
    return run(["dnf5", "upgrade"], args.dry_run, logger)


def cmd_doctor(args, logger) -> int:
    ok = True
    for pkg in ["fish", "ghostty", "tmux", "neovim"]:
        rc = subprocess.run(["rpm", "-q", pkg], check=False, capture_output=True).returncode
        logger.info("%-10s %s", pkg, "installed" if rc == 0 else "MISSING")
        ok = ok and rc == 0
    return 0 if ok else 1


def cmd_fw(args, logger) -> int:
    if args.fw_cmd == "open":
        return run(["firewall-cmd", "--add-port", f"{args.port}/tcp"], args.dry_run, logger)
    logger.error("unknown fw subcommand: %s", args.fw_cmd)
    return 2


def cmd_tpm(args, logger) -> int:
    if args.tpm_cmd == "enroll":
        stub = ["systemd-cryptenroll", "--tpm2-device=auto"]
        logger.info("TPM2 enrollment is opt-in; the LUKS passphrase remains as recovery")
        return run(stub, args.dry_run, logger)
    logger.error("unknown tpm subcommand: %s", args.tpm_cmd)
    return 2


def main() -> int:
    p = argparse.ArgumentParser(prog="anu", description=__doc__)
    p.add_argument("--dry-run", action="store_true", help="print actions without running them")
    sub = p.add_subparsers(dest="command", required=True)

    sp = sub.add_parser("setup", help="post-install wizard")
    sp.set_defaults(func=cmd_setup)

    sp = sub.add_parser("install", help="install an app from the registry")
    sp.add_argument("id")
    sp.set_defaults(func=cmd_install)

    sp = sub.add_parser("update", help="update the system")
    sp.set_defaults(func=cmd_update)

    sp = sub.add_parser("doctor", help="check UrukOS packages")
    sp.set_defaults(func=cmd_doctor)

    sp = sub.add_parser("fw", help="firewall helpers")
    sp.add_argument("fw_cmd", choices=["open"])
    sp.add_argument("port", type=int)
    sp.set_defaults(func=cmd_fw)

    sp = sub.add_parser("tpm", help="TPM2 helpers")
    sp.add_argument("tpm_cmd", choices=["enroll"])
    sp.set_defaults(func=cmd_tpm)

    args = p.parse_args()
    logger = get_logger()
    try:
        return args.func(args, logger)
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main())
